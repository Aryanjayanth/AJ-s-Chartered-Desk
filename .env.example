# Client-side Supabase configuration (required in browser)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Server-side Supabase configuration (required for TanStack Start SSR & RPC handlers)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Application host URL for email invitations and auth redirects
APP_URL="https://ajs-chartered-desk.vercel.app"

# Cron secret for securing external recurring job trigger endpoints (optional)
CRON_SECRET="your-secure-random-token"

